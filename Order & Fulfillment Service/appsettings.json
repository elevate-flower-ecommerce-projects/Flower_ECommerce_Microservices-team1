{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseInitialization": {
    "ResetOnStartup": false
  },
  "Jwt": {
    "Key": "YOUR_SUPER_SECRET_KEY_CHANGE_IN_PRODUCTION_MIN_32_CHARS",
    "Issuer": "FlowersAuth",
    "Audience": "FlowersApp"
  },
  "Services": {
    "CartBaseUrl": "http://cartservice:8080",
    "AddressBaseUrl": "http://addressstorecoverageservice:8080",
    "TimeoutSeconds": 5
  },
  "Checkout": {
    "DeliveryFee": 50
  },
  "Internal": {
    "Secret": "",
    "HeaderName": "X-Internal-Secret"
  }
}
