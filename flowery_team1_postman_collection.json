    {
      "name": "Authentication (Team 1)",
      "item": [
        {
          "name": "User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.token) {",
                  "    pm.collectionVariables.set('bearerToken', jsonData.token);",
                  "    console.log('Saved token to bearerToken variable');",
                  "} else if (jsonData && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('bearerToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "identity", "auth", "login"]
            }
          }
        },
        {
          "name": "User Login (Direct Path)",
          "request": {
            "method": "POST",
