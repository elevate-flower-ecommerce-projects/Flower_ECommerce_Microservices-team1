{
  "info": {
    "_postman_id": "flowery-team1-api-gateway-collection",
    "name": "Flowery E-Commerce API Gateway (Team 1)",
    "description": "Complete Postman Collection for Team 1 Microservices mapped through API Gateway (Port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "API Gateway URL (Port 8080)"
    },
    {
      "key": "bearerToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer Token for Authenticated Requests"
    },
    {
      "key": "acceptLanguage",
      "value": "en",
      "type": "string",
      "description": "Language header (en or ar)"
    }
  ],
