{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "address-store-coverage-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/address-store-coverage/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/address-store-coverage"
          }
        ]
      },
      "user-addresses-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/users/me/addresses"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1"
          }
        ]
      },
      "user-address-details-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/users/me/addresses/{addressId}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1"
          }
        ]
      },      "admin-stores-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/admin/stores/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1"
          }
        ]
      },
      "store-resolve-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/stores/resolve"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1"
          }
        ]
      },      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/v1/cart/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/cart"
          }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/catalog"
          }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/identity"
          }
        ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/orders"
          }
        ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/payments"
          }
        ]
      }
    },
    "Clusters": {
      "address-store-coverage-cluster": {
        "Destinations": {
          "address-store-coverage": {
            "Address": "http://addressstorecoverageservice:8080/"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart": {
            "Address": "http://cartservice:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://catalogservice:8080/"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://identityservice:8080/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders": {
            "Address": "http://orderfulfillmentservice:8080/"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "payments": {
            "Address": "http://paymentservice:8080/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
