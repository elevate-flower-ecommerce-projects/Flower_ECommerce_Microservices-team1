{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route-health": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "identity-route-prefix": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/identity" }
        ]
      },

      "catalog-route-health": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "catalog-route-prefix": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/catalog" }
        ]
      },

      "cart-route-health": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/cart"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "cart-route-prefix": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/cart/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/cart" }
        ]
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/v1/cart/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/cart" }
        ]
      },

      "orders-route-health": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "orders-route-health-singular": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/order"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "orders-route-prefix": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/orders" }
        ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/orders" }
        ]
      },

      "payments-route-health": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/payments"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "payments-route-health-singular": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/payment"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "payments-route-prefix": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/payments/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/payments" }
        ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/payments" }
        ]
      },

      "address-store-coverage-route-health": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/address"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "address-store-coverage-route-health-full": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/address-store-coverage"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "address-store-coverage-route-prefix": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/address/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/address" }
        ]
      },
      "address-store-coverage-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/address-store-coverage/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/address-store-coverage" }
        ]
      }
    },
    "Clusters": {
      "address-store-coverage-cluster": {
        "Destinations": {
          "address-store-coverage": {
            "Address": "http://addressstorecoverageservice:8080/"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart": {
            "Address": "http://cartservice:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://catalogservice:8080/"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://identityservice:8080/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders": {
            "Address": "http://orderfulfillmentservice:8080/"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "payments": {
            "Address": "http://paymentservice:8080/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
