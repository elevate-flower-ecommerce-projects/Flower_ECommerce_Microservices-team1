{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-v1-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/identity" }
        ]
      },
      "identity-prefix-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "user-addresses-v1-root-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/users/me/addresses"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "user-addresses-v1-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/users/me/addresses/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "admin-stores-v1-root-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/admin/stores"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "admin-stores-v1-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/admin/stores/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "store-resolve-v1-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/stores/resolve"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "address-store-coverage-v1-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/api/v1/address-store-coverage/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/address-store-coverage" }
        ]
      },
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "user-addresses-direct-root-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/users/me/addresses"
        }
      },
      "user-addresses-direct-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/users/me/addresses/{**catch-all}"
        }
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "admin-stores-direct-root-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/admin/stores"
        }
      },
      "admin-stores-direct-route": {
        "ClusterId": "address-store-coverage-cluster",
        "Match": {
          "Path": "/admin/stores/{**catch-all}"
        }
      },
      "identity-admin-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/admin/{**catch-all}"
        }
